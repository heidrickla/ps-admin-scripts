# Runtime artefacts the toolkit creates beside itself. None of these belong in git:
# the store holds credentials, the logs hold whatever went wrong, and the imported
# copies are generated from a source that IS tracked.
adadmin-store.json
adadmin-scripts/
adadmin-logs/

